# Albumklubben block in /opt/caddy/Caddyfile (Caddy runs in Docker, see /root/CLAUDE.md).
# No password here: the app itself lets in only members of the club's Theta group (server/theta-auth.ts).
albumklubben.dk {
	encode zstd gzip
	header {
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
	}
	header ?X-Frame-Options SAMEORIGIN
	@robots path /robots.txt
	respond @robots "User-agent: *
Disallow: /
" 200
	request_body {
		max_size 600MB
	}
	# The app listens on docker0 (HOST=172.17.0.1 in .env), which host.docker.internal points to.
	reverse_proxy host.docker.internal:3600
}
