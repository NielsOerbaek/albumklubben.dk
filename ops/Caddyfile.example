# Albumklubben block in /opt/caddy/Caddyfile (Caddy runs in Docker, see /root/CLAUDE.md).
# No password here: the app itself lets in only members of the club's Theta group (server/theta-auth.ts).
albumklubben.dk {
	encode zstd gzip
	header {
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
	}
	header ?X-Frame-Options SAMEORIGIN
	# robots.txt is not what keeps anyone out — the Theta login is, and the only thing any
	# crawler can reach without a session is the login page and the icons. "Disallow: /" bought
	# nothing and cost the link previews: Slack, Facebook, Twitter and the rest read this file
	# before unfurling, and will not draw a card for a page they were told not to fetch.
	# So: anyone may fetch the door, the training crawlers may not, and X-Robots-Tag above still
	# keeps the whole site out of every search index.
	@robots path /robots.txt
	respond @robots "User-agent: GPTBot
User-agent: ClaudeBot
User-agent: Claude-User
User-agent: anthropic-ai
User-agent: CCBot
User-agent: Google-Extended
User-agent: Applebot-Extended
User-agent: Bytespider
User-agent: meta-externalagent
User-agent: PerplexityBot
Disallow: /

User-agent: *
Disallow: /api/
Allow: /
" 200
	request_body {
		max_size 600MB
	}
	# The app listens on docker0 (HOST=172.17.0.1 in .env), which host.docker.internal points to.
	reverse_proxy host.docker.internal:3600
}
